//@version=6
indicator("MTF Stochastics PRO v1", shorttitle = "MTFSTOCH", overlay = false, max_labels_count = 500)

// ============================================================================
// MTF Stochastics PRO v1
//
// Portfolio goals:
// - Pine Script v6
// - Adaptive MTF Stochastic oscillator
// - Reversal + momentum signals
// - Confirmed requested-timeframe data only
// - No future leak / stable HTF request pattern
// - MTF consensus, dashboard, alerts and JSON payloads
// ============================================================================

const string GRP_STO  = "1. Stochastic"
const string GRP_SIG  = "2. Signal Engine"
const string GRP_MTF  = "3. Multi-Timeframe"
const string GRP_CONS = "4. MTF Confirmation"
const string GRP_VIS  = "5. Visuals"
const string GRP_ALT  = "6. Alerts"

// ---------- Stochastic ----------
int kLength = input.int(14, "%K length", minval = 1, group = GRP_STO)
int smoothK = input.int(3, "%K smoothing", minval = 1, group = GRP_STO)
int dLength = input.int(3, "%D smoothing", minval = 1, group = GRP_STO)
float overbought = input.float(80.0, "Overbought", minval = 50.0, maxval = 100.0, step = 0.5, group = GRP_STO)
float oversold = input.float(20.0, "Oversold", minval = 0.0, maxval = 50.0, step = 0.5, group = GRP_STO)
float midline = input.float(50.0, "Momentum midline", minval = 1.0, maxval = 99.0, step = 0.5, group = GRP_STO)

if oversold >= overbought
    runtime.error("Oversold must be below Overbought.")

// ---------- Signal engine ----------
bool useReversal = input.bool(true, "Zone reversal crosses", group = GRP_SIG)
bool useMomentum = input.bool(true, "Midline momentum crosses", group = GRP_SIG)
bool requireKDAlignment = input.bool(true, "Require %K/%D alignment for momentum", group = GRP_SIG)

if not useReversal and not useMomentum
    runtime.error("Enable at least one signal family.")

// ---------- Multi-timeframe ----------
string tfMode = input.string("Auto", "Timeframe mode", options = ["Auto", "Manual"], group = GRP_MTF)

bool useTf1 = input.bool(true, "Enable TF1", inline = "tf1", group = GRP_MTF)
string manualTf1 = input.timeframe("60", "Manual TF1", inline = "tf1", group = GRP_MTF)
bool useTf2 = input.bool(true, "Enable TF2", inline = "tf2", group = GRP_MTF)
string manualTf2 = input.timeframe("240", "Manual TF2", inline = "tf2", group = GRP_MTF)
bool useTf3 = input.bool(true, "Enable TF3", inline = "tf3", group = GRP_MTF)
string manualTf3 = input.timeframe("1D", "Manual TF3", inline = "tf3", group = GRP_MTF)

int chartTfSec = timeframe.in_seconds()

f_autoTf2(int _chartSec) =>
    _chartSec < timeframe.in_seconds("60")   ? "60" :
     _chartSec < timeframe.in_seconds("240") ? "240" :
     _chartSec < timeframe.in_seconds("1D")  ? "1D" :
     _chartSec < timeframe.in_seconds("1W")  ? "1W" :
     _chartSec < timeframe.in_seconds("1M")  ? "1M" :
     _chartSec < timeframe.in_seconds("3M")  ? "3M" :
     _chartSec < timeframe.in_seconds("6M")  ? "6M" :
     _chartSec < timeframe.in_seconds("12M") ? "12M" :
     timeframe.period

f_autoTf3(int _chartSec) =>
    _chartSec < timeframe.in_seconds("60")   ? "240" :
     _chartSec < timeframe.in_seconds("240") ? "1D" :
     _chartSec < timeframe.in_seconds("1D")  ? "1W" :
     _chartSec < timeframe.in_seconds("1W")  ? "1M" :
     _chartSec < timeframe.in_seconds("1M")  ? "3M" :
     _chartSec < timeframe.in_seconds("3M")  ? "6M" :
     _chartSec < timeframe.in_seconds("6M")  ? "12M" :
     timeframe.period

bool autoMode = tfMode == "Auto"
string tf1 = autoMode ? timeframe.period : manualTf1
string tf2 = autoMode ? f_autoTf2(chartTfSec) : manualTf2
string tf3 = autoMode ? f_autoTf3(chartTfSec) : manualTf3

if not autoMode and useTf1 and timeframe.in_seconds(tf1) < chartTfSec
    runtime.error("Manual TF1 must be equal to or higher than the chart timeframe.")
if not autoMode and useTf2 and timeframe.in_seconds(tf2) < chartTfSec
    runtime.error("Manual TF2 must be equal to or higher than the chart timeframe.")
if not autoMode and useTf3 and timeframe.in_seconds(tf3) < chartTfSec
    runtime.error("Manual TF3 must be equal to or higher than the chart timeframe.")

int enabledTfCount = (useTf1 ? 1 : 0) + (useTf2 ? 1 : 0) + (useTf3 ? 1 : 0)
if enabledTfCount == 0
    runtime.error("Enable at least one timeframe.")

// ---------- MTF confirmation ----------
string consensusMode = input.string("Either", "Consensus signal family", options = ["Reversal", "Momentum", "Either"], group = GRP_CONS)
int minTfConfirmations = input.int(2, "Minimum confirming timeframes", minval = 1, maxval = 3, group = GRP_CONS)
int confirmationWindow = input.int(6, "Confirmation window (chart bars)", minval = 1, maxval = 100, group = GRP_CONS)

// ---------- Visuals ----------
string displayTf = input.string("TF1", "Oscillator pane source", options = ["TF1", "TF2", "TF3"], group = GRP_VIS)
bool showIndividualSignals = input.bool(false, "Show individual TF signals", group = GRP_VIS)
bool showConsensusSignals = input.bool(true, "Show MTF consensus", group = GRP_VIS)
bool showDashboard = input.bool(true, "Show dashboard", group = GRP_VIS)

// ---------- Alerts ----------
bool jsonAlerts = input.bool(true, "Enable JSON consensus alerts", group = GRP_ALT)

// ============================================================================
// Core
// ============================================================================

f_stochCore(int _kLength, int _smoothK, int _dLength, float _ob, float _os, float _mid, bool _align) =>
    float rawK = ta.stoch(close, high, low, _kLength)
    float k = ta.sma(rawK, _smoothK)
    float d = ta.sma(k, _dLength)

    bool bullReversal = ta.crossover(k, d) and math.min(k, d) <= _os
    bool bearReversal = ta.crossunder(k, d) and math.max(k, d) >= _ob

    bool bullMomentumBase = ta.crossover(k, _mid)
    bool bearMomentumBase = ta.crossunder(k, _mid)
    bool bullMomentum = bullMomentumBase and (not _align or k > d)
    bool bearMomentum = bearMomentumBase and (not _align or k < d)

    [bullReversal, bearReversal, bullMomentum, bearMomentum, k, d]

f_confirmedPack(int _kLength, int _smoothK, int _dLength, float _ob, float _os, float _mid, bool _align) =>
    [br, sr, bm, sm, k, d] = f_stochCore(_kLength, _smoothK, _dLength, _ob, _os, _mid, _align)
    [br[1], sr[1], bm[1], sm[1], k[1], d[1], time[1]]

// ============================================================================
// Confirmed MTF requests
// ============================================================================

[tf1BullRevRaw, tf1BearRevRaw, tf1BullMomRaw, tf1BearMomRaw, tf1K, tf1D, tf1Time] = request.security(
    syminfo.tickerid,
    tf1,
    f_confirmedPack(kLength, smoothK, dLength, overbought, oversold, midline, requireKDAlignment),
    gaps = barmerge.gaps_off,
    lookahead = barmerge.lookahead_on)

[tf2BullRevRaw, tf2BearRevRaw, tf2BullMomRaw, tf2BearMomRaw, tf2K, tf2D, tf2Time] = request.security(
    syminfo.tickerid,
    tf2,
    f_confirmedPack(kLength, smoothK, dLength, overbought, oversold, midline, requireKDAlignment),
    gaps = barmerge.gaps_off,
    lookahead = barmerge.lookahead_on)

[tf3BullRevRaw, tf3BearRevRaw, tf3BullMomRaw, tf3BearMomRaw, tf3K, tf3D, tf3Time] = request.security(
    syminfo.tickerid,
    tf3,
    f_confirmedPack(kLength, smoothK, dLength, overbought, oversold, midline, requireKDAlignment),
    gaps = barmerge.gaps_off,
    lookahead = barmerge.lookahead_on)

// Convert held requested-timeframe states to one-chart-bar event pulses.
bool tf1BullRev = useTf1 and useReversal and tf1BullRevRaw and not tf1BullRevRaw[1]
bool tf1BearRev = useTf1 and useReversal and tf1BearRevRaw and not tf1BearRevRaw[1]
bool tf1BullMom = useTf1 and useMomentum and tf1BullMomRaw and not tf1BullMomRaw[1]
bool tf1BearMom = useTf1 and useMomentum and tf1BearMomRaw and not tf1BearMomRaw[1]

bool tf2BullRev = useTf2 and useReversal and tf2BullRevRaw and not tf2BullRevRaw[1]
bool tf2BearRev = useTf2 and useReversal and tf2BearRevRaw and not tf2BearRevRaw[1]
bool tf2BullMom = useTf2 and useMomentum and tf2BullMomRaw and not tf2BullMomRaw[1]
bool tf2BearMom = useTf2 and useMomentum and tf2BearMomRaw and not tf2BearMomRaw[1]

bool tf3BullRev = useTf3 and useReversal and tf3BullRevRaw and not tf3BullRevRaw[1]
bool tf3BearRev = useTf3 and useReversal and tf3BearRevRaw and not tf3BearRevRaw[1]
bool tf3BullMom = useTf3 and useMomentum and tf3BullMomRaw and not tf3BullMomRaw[1]
bool tf3BearMom = useTf3 and useMomentum and tf3BearMomRaw and not tf3BearMomRaw[1]

f_familyEvent(bool rev, bool mom) =>
    consensusMode == "Reversal" ? rev :
     consensusMode == "Momentum" ? mom :
     (rev or mom)

bool tf1BullEvent = f_familyEvent(tf1BullRev, tf1BullMom)
bool tf1BearEvent = f_familyEvent(tf1BearRev, tf1BearMom)
bool tf2BullEvent = f_familyEvent(tf2BullRev, tf2BullMom)
bool tf2BearEvent = f_familyEvent(tf2BearRev, tf2BearMom)
bool tf3BullEvent = f_familyEvent(tf3BullRev, tf3BullMom)
bool tf3BearEvent = f_familyEvent(tf3BearRev, tf3BearMom)

f_recent(bool event, int windowBars) =>
    int since = ta.barssince(event)
    not na(since) and since <= windowBars

bool tf1BullRecent = useTf1 and f_recent(tf1BullEvent, confirmationWindow)
bool tf1BearRecent = useTf1 and f_recent(tf1BearEvent, confirmationWindow)
bool tf2BullRecent = useTf2 and f_recent(tf2BullEvent, confirmationWindow)
bool tf2BearRecent = useTf2 and f_recent(tf2BearEvent, confirmationWindow)
bool tf3BullRecent = useTf3 and f_recent(tf3BullEvent, confirmationWindow)
bool tf3BearRecent = useTf3 and f_recent(tf3BearEvent, confirmationWindow)

int bullConfirmations = (tf1BullRecent ? 1 : 0) + (tf2BullRecent ? 1 : 0) + (tf3BullRecent ? 1 : 0)
int bearConfirmations = (tf1BearRecent ? 1 : 0) + (tf2BearRecent ? 1 : 0) + (tf3BearRecent ? 1 : 0)
int requiredConfirmations = math.min(minTfConfirmations, enabledTfCount)

bool bullConsensusState = bullConfirmations >= requiredConfirmations
bool bearConsensusState = bearConfirmations >= requiredConfirmations
bool bullConsensus = bullConsensusState and not bullConsensusState[1]
bool bearConsensus = bearConsensusState and not bearConsensusState[1]

// ============================================================================
// Plots
// ============================================================================

float displayK = displayTf == "TF1" ? tf1K : displayTf == "TF2" ? tf2K : tf3K
float displayD = displayTf == "TF1" ? tf1D : displayTf == "TF2" ? tf2D : tf3D

plot(displayK, "Confirmed MTF %K", color = color.aqua, linewidth = 2)
plot(displayD, "Confirmed MTF %D", color = color.orange, linewidth = 2)

hline(overbought, "Overbought", color = color.new(color.red, 35))
hline(midline, "Midline", color = color.new(color.gray, 65))
hline(oversold, "Oversold", color = color.new(color.lime, 35))

plotshape(showIndividualSignals and tf1BullRev, title = "TF1 bullish reversal", style = shape.triangleup, location = location.bottom, color = color.lime, text = "R1", size = size.tiny)
plotshape(showIndividualSignals and tf1BearRev, title = "TF1 bearish reversal", style = shape.triangledown, location = location.top, color = color.red, text = "R1", size = size.tiny)
plotshape(showIndividualSignals and tf2BullRev, title = "TF2 bullish reversal", style = shape.triangleup, location = location.bottom, color = color.new(color.lime, 20), text = "R2", size = size.tiny)
plotshape(showIndividualSignals and tf2BearRev, title = "TF2 bearish reversal", style = shape.triangledown, location = location.top, color = color.new(color.red, 20), text = "R2", size = size.tiny)
plotshape(showIndividualSignals and tf3BullRev, title = "TF3 bullish reversal", style = shape.triangleup, location = location.bottom, color = color.new(color.lime, 40), text = "R3", size = size.tiny)
plotshape(showIndividualSignals and tf3BearRev, title = "TF3 bearish reversal", style = shape.triangledown, location = location.top, color = color.new(color.red, 40), text = "R3", size = size.tiny)

plotshape(showIndividualSignals and tf1BullMom, title = "TF1 bullish momentum", style = shape.circle, location = location.bottom, color = color.teal, text = "M1", size = size.tiny)
plotshape(showIndividualSignals and tf1BearMom, title = "TF1 bearish momentum", style = shape.circle, location = location.top, color = color.maroon, text = "M1", size = size.tiny)
plotshape(showIndividualSignals and tf2BullMom, title = "TF2 bullish momentum", style = shape.circle, location = location.bottom, color = color.new(color.teal, 20), text = "M2", size = size.tiny)
plotshape(showIndividualSignals and tf2BearMom, title = "TF2 bearish momentum", style = shape.circle, location = location.top, color = color.new(color.maroon, 20), text = "M2", size = size.tiny)
plotshape(showIndividualSignals and tf3BullMom, title = "TF3 bullish momentum", style = shape.circle, location = location.bottom, color = color.new(color.teal, 40), text = "M3", size = size.tiny)
plotshape(showIndividualSignals and tf3BearMom, title = "TF3 bearish momentum", style = shape.circle, location = location.top, color = color.new(color.maroon, 40), text = "M3", size = size.tiny)

plotshape(showConsensusSignals and bullConsensus, title = "MTF bullish Stochastic consensus", style = shape.labelup, location = location.bottom, color = color.green, text = "MTF BULL", textcolor = color.white, size = size.small)
plotshape(showConsensusSignals and bearConsensus, title = "MTF bearish Stochastic consensus", style = shape.labeldown, location = location.top, color = color.red, text = "MTF BEAR", textcolor = color.white, size = size.small)

// ============================================================================
// Dashboard
// ============================================================================

f_zoneText(float k, float d) =>
    k >= overbought and d >= overbought ? "OB" :
     k <= oversold and d <= oversold ? "OS" :
     k > d ? "BULL" :
     k < d ? "BEAR" :
     "FLAT"

f_zoneColor(float k, float d) =>
    k >= overbought and d >= overbought ? color.red :
     k <= oversold and d <= oversold ? color.green :
     k > d ? color.new(color.green, 35) :
     k < d ? color.new(color.red, 35) :
     color.new(color.gray, 70)

var table dashboard = table.new(position.top_right, 5, 6, frame_width = 1, border_width = 1)

if barstate.islast and showDashboard
    table.cell(dashboard, 0, 0, autoMode ? "TF AUTO" : "TF MAN", text_color = color.white, bgcolor = color.new(color.gray, 60))
    table.cell(dashboard, 1, 0, "State", text_color = color.white, bgcolor = color.new(color.gray, 60))
    table.cell(dashboard, 2, 0, "%K", text_color = color.white, bgcolor = color.new(color.gray, 60))
    table.cell(dashboard, 3, 0, "%D", text_color = color.white, bgcolor = color.new(color.gray, 60))
    table.cell(dashboard, 4, 0, "Enabled", text_color = color.white, bgcolor = color.new(color.gray, 60))

    table.cell(dashboard, 0, 1, tf1)
    table.cell(dashboard, 1, 1, f_zoneText(tf1K, tf1D), bgcolor = f_zoneColor(tf1K, tf1D), text_color = color.white)
    table.cell(dashboard, 2, 1, str.tostring(tf1K, "#.0"))
    table.cell(dashboard, 3, 1, str.tostring(tf1D, "#.0"))
    table.cell(dashboard, 4, 1, useTf1 ? "YES" : "NO")

    table.cell(dashboard, 0, 2, tf2)
    table.cell(dashboard, 1, 2, f_zoneText(tf2K, tf2D), bgcolor = f_zoneColor(tf2K, tf2D), text_color = color.white)
    table.cell(dashboard, 2, 2, str.tostring(tf2K, "#.0"))
    table.cell(dashboard, 3, 2, str.tostring(tf2D, "#.0"))
    table.cell(dashboard, 4, 2, useTf2 ? "YES" : "NO")

    table.cell(dashboard, 0, 3, tf3)
    table.cell(dashboard, 1, 3, f_zoneText(tf3K, tf3D), bgcolor = f_zoneColor(tf3K, tf3D), text_color = color.white)
    table.cell(dashboard, 2, 3, str.tostring(tf3K, "#.0"))
    table.cell(dashboard, 3, 3, str.tostring(tf3D, "#.0"))
    table.cell(dashboard, 4, 3, useTf3 ? "YES" : "NO")

    table.cell(dashboard, 0, 4, "MTF")
    table.cell(dashboard, 1, 4, bullConsensusState ? "BULL" : bearConsensusState ? "BEAR" : "—",
        bgcolor = bullConsensusState ? color.green : bearConsensusState ? color.red : color.new(color.gray, 75),
        text_color = color.white)
    table.cell(dashboard, 2, 4, str.tostring(bullConfirmations) + "B")
    table.cell(dashboard, 3, 4, str.tostring(bearConfirmations) + "S")
    table.cell(dashboard, 4, 4, str.tostring(requiredConfirmations) + " req.")

    table.cell(dashboard, 0, 5, "Chart")
    table.cell(dashboard, 1, 5, timeframe.period)
    table.cell(dashboard, 2, 5, consensusMode)
    table.cell(dashboard, 3, 5, autoMode ? "AUTO" : "MAN")
    table.cell(dashboard, 4, 5, "v1")

// ============================================================================
// Alerts
// ============================================================================

bool anyBullReversal = tf1BullRev or tf2BullRev or tf3BullRev
bool anyBearReversal = tf1BearRev or tf2BearRev or tf3BearRev
bool anyBullMomentum = tf1BullMom or tf2BullMom or tf3BullMom
bool anyBearMomentum = tf1BearMom or tf2BearMom or tf3BearMom

alertcondition(anyBullReversal, "Any bullish Stochastic reversal", "Confirmed bullish Stochastic zone reversal on one enabled timeframe for {{exchange}}:{{ticker}}.")
alertcondition(anyBearReversal, "Any bearish Stochastic reversal", "Confirmed bearish Stochastic zone reversal on one enabled timeframe for {{exchange}}:{{ticker}}.")
alertcondition(anyBullMomentum, "Any bullish Stochastic momentum", "Confirmed bullish Stochastic midline momentum event on one enabled timeframe for {{exchange}}:{{ticker}}.")
alertcondition(anyBearMomentum, "Any bearish Stochastic momentum", "Confirmed bearish Stochastic midline momentum event on one enabled timeframe for {{exchange}}:{{ticker}}.")
alertcondition(bullConsensus, "MTF bullish Stochastic consensus", "Confirmed multi-timeframe bullish Stochastic consensus for {{exchange}}:{{ticker}}.")
alertcondition(bearConsensus, "MTF bearish Stochastic consensus", "Confirmed multi-timeframe bearish Stochastic consensus for {{exchange}}:{{ticker}}.")

if jsonAlerts and barstate.isconfirmed and bullConsensus
    alert(
        '{"event":"mtf_stochastics","version":"1.0","direction":"bullish","ticker":"' +
        syminfo.tickerid + '","chart_tf":"' + timeframe.period + '","tf1":"' + tf1 +
        '","tf2":"' + tf2 + '","tf3":"' + tf3 + '","mode":"' + consensusMode +
        '","confirmations":' + str.tostring(bullConfirmations) + '}',
        alert.freq_once_per_bar_close)

if jsonAlerts and barstate.isconfirmed and bearConsensus
    alert(
        '{"event":"mtf_stochastics","version":"1.0","direction":"bearish","ticker":"' +
        syminfo.tickerid + '","chart_tf":"' + timeframe.period + '","tf1":"' + tf1 +
        '","tf2":"' + tf2 + '","tf3":"' + tf3 + '","mode":"' + consensusMode +
        '","confirmations":' + str.tostring(bearConfirmations) + '}',
        alert.freq_once_per_bar_close)
